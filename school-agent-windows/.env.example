# Copied to .env automatically on first run (setup.bat / setup.sh). Edit .env,
# not this file — .env is gitignored, this example file isn't.
#
# Everything here is also editable inside the app: Settings -> Model & keys.
# Changes made there are written back to .env and apply immediately.
#
# A model powers chat, quiz generation, get-ahead summaries, drafting, and
# reading the grading table out of a syllabus. Deadline sync, documents, and
# grade calculations all work with nothing configured here at all.

# Which provider to use: auto | openai | anthropic | gemini | ollama
# "auto" takes the first one with a key, in the order below, then local Ollama.
# Naming one pins it — if it isn't usable you get an error rather than a
# silent switch to a different model.
SCHOOL_AGENT_PROVIDER=auto

# --- OpenAI, or any OpenAI-compatible endpoint -------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SCHOOL_AGENT_OPENAI_MODEL=gpt-5.6-luna

# --- Claude (console.anthropic.com) ------------------------------------
ANTHROPIC_API_KEY=
SCHOOL_AGENT_ANTHROPIC_MODEL=claude-sonnet-5

# --- Gemini (aistudio.google.com) --------------------------------------
GEMINI_API_KEY=
SCHOOL_AGENT_GEMINI_MODEL=gemini-3.7-flash

# --- Local, free, private: used when no cloud key is set ---------------
OLLAMA_BASE_URL=http://localhost:11434
SCHOOL_AGENT_OLLAMA_MODEL=gemma4:12b

# --- Which timezone your due dates are in ------------------------------
# Optional. Left blank, the app uses your computer's own clock, which is
# almost always right. Set it if the machine clock is on a different zone
# than you are — an IANA name like America/New_York, Europe/London.
# This decides what counts as "due today" vs "overdue", so it matters more
# than it looks.
SCHOOL_AGENT_TIMEZONE=
